rules_version = '2';

// Production security rules.
// Principles:
//  - No anonymous access. Every rule requires request.auth != null.
//  - Per-user isolation: users can only read/write documents they own
//    (matched via a `userId` field, or a uid-prefixed document id).
//  - The Firebase Admin SDK (used by the server API routes) BYPASSES these
//    rules entirely, so tightening them does NOT affect server-side processing.
service cloud.firestore {
  match /databases/{database}/documents {

    // True when the EXISTING document is owned by the caller (read/update/delete).
    function ownsExisting() {
      return request.auth != null && request.auth.uid == resource.data.userId;
    }
    // True when the INCOMING document will be owned by the caller (create/update).
    function ownsIncoming() {
      return request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // A user's own profile document (doc id == uid).
    // NOTE: credits live here and are currently adjusted client-side, so the
    // owner can write this doc. The real spend backstop is the OpenAI usage cap.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Per-user dashboard metrics (doc id == uid; body has no userId field).
    match /user_metrics/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Brands. Doc id (brandId) is typically `${uid}_...`, and the doc also
    // carries a userId field — allow if either matches.
    match /v8userbrands/{brandId} {
      allow read, delete: if request.auth != null &&
        (request.auth.uid == resource.data.userId || request.auth.uid == brandId.split('_')[0]);
      allow create, update: if request.auth != null &&
        (request.auth.uid == request.resource.data.userId || request.auth.uid == brandId.split('_')[0]);
    }

    // Per-user data collections (each document has a `userId` field).
    match /v8detailed_query_results/{docId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }
    match /v8_user_brand_analytics/{docId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }
    match /v8_lifetime_brand_analytics/{docId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }
    match /user_recommendations/{docId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }
    match /user_top_domains/{docId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }
    match /user_trends/{docId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }
    match /user_brand_prompts/{docId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }
    // Raw per-query records (each doc has userId + brandId). Read queries filter
    // by userId or by an owner-scoped brandId, so per-doc ownership holds.
    match /v8userqueries/{docId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }

    // Competitor analytics is keyed by brandId (`${brandId}_${session}`) and is
    // non-sensitive aggregate data. Require sign-in; not isolated per user.
    match /v8competitoranalytics/{docId} {
      allow read, write: if request.auth != null;
    }

    // Shared, cross-user leaderboard. Readable by any signed-in user.
    match /brand_leaderboard/{docId} {
      allow read, write: if request.auth != null;
    }

    // Default deny: anything not matched above is inaccessible to clients.
    // (The Admin SDK still has full access for server-side processing.)
  }
}
